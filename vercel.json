{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/bff/(.*)", "destination": "https://staging-api.enginefilemedia.com/bff/$1" },
    { "source": "/api/(.*)", "destination": "https://staging-api.enginefilemedia.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}